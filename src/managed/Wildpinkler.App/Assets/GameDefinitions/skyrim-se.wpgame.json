{
  "schemaVersion": 2,
  "definitionId": "skyrim-se",
  "name": "The Elder Scrolls V: Skyrim Special Edition",
  "definitionVersion": 2,
  "author": "Wildpinkler",
  "description": "Built-in definition for Skyrim Special Edition / Anniversary Edition.",
  "steamAppId": "489830",
  "executableRelativePath": "SkyrimSE.exe",
  "remoteGameKeys": {
    "nexus": "skyrimspecialedition"
  },
  "detectionMarkers": [
    "SkyrimSE.exe",
    "Data\\Skyrim.esm"
  ],
  "variables": {
    "documents": "${Documents}\\My Games\\Skyrim Special Edition",
    "localappdata": "${LocalAppData}\\Skyrim Special Edition"
  },
  "mergedViews": [
    {
      "name": "Documents",
      "mountPath": "${documents}",
      "branches": [
        "Documents",
        "${documents}"
      ],
      "isWritable": true
    },
    {
      "name": "LocalAppData",
      "mountPath": "${localappdata}",
      "branches": [
        "LocalAppData",
        "${localappdata}"
      ],
      "isWritable": true
    }
  ],
  "defaultLaunchArguments": ""
}
