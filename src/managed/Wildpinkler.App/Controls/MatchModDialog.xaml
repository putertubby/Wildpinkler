<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Wildpinkler.App.Controls.MatchModDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Wildpinkler.App.Controls"
    Title="Identify or satisfy this requirement"
    PrimaryButtonText="Apply"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel Spacing="12" MinWidth="420">
        <TextBlock x:Name="ExplanationText" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.85" TextWrapping="Wrap"
                   Text="Choose a library mod to identify this requirement, or a mod already in the plan to satisfy it. Confirmed choices are remembered." />
        <TextBlock x:Name="RecommendationText" Style="{StaticResource CaptionTextBlockStyle}"
                   TextWrapping="Wrap" Visibility="Collapsed" />

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="SourceCombo" Header="Choose from" SelectedIndex="0"
                      SelectionChanged="SourceCombo_SelectionChanged">
                <ComboBoxItem Content="Library" Tag="library" />
                <ComboBoxItem Content="Plan" Tag="plan" />
            </ComboBox>
            <TextBox x:Name="SearchBox" Grid.Column="1" Header="Search" PlaceholderText="Name, version, or identifier"
                     AutomationProperties.Name="Search mods" TextChanged="SearchBox_TextChanged" />
        </Grid>

        <TextBlock x:Name="ResultCountText" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.68" />
        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
            <Grid MinHeight="180">
                <ListView x:Name="CandidateList" MaxHeight="360" SelectionMode="Single"
                          ItemContainerStyle="{StaticResource ListRowContainerStyle}"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectionChanged="CandidateList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="controls:MatchModPickerRow">
                            <Grid Padding="12,8" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" MinWidth="180" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource RowAvatarStyle}">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{Binding Initial}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                    <TextBlock Opacity="0.68" TextWrapping="Wrap" Text="{Binding Subtitle}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16"
                           TextAlignment="Center" TextWrapping="Wrap" Opacity="0.68" Visibility="Collapsed" />
            </Grid>
        </Border>
    </StackPanel>
</ContentDialog>
