<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Wildpinkler.App.Controls.ToolEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Tool"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ScrollViewer MaxHeight="480" Padding="0,0,16,0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20">
            <InfoBar x:Name="DefinitionBar" IsOpen="False" IsClosable="False" Severity="Informational" />

            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SectionLabelStyle}" Text="GENERAL" />
                <TextBox x:Name="NameBox" Header="Name" TextChanged="Field_Changed" />
                <TextBlock x:Name="NameErrorText" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           Text="A tool with this name already exists." Visibility="Collapsed" />
            </StackPanel>

            <Border x:Name="LocationDivider" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" />

            <StackPanel x:Name="LocationSection" Spacing="12">
                <TextBlock Style="{StaticResource SectionLabelStyle}" Text="LOCATION" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InstallPathBox" Header="Install path" TextChanged="Field_Changed" />
                    <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Browse..." Click="BrowseInstallPath_Click" />
                </Grid>
                <TextBlock x:Name="PickerErrorText" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" />

            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SectionLabelStyle}" Text="LAUNCH" />
                <TextBox x:Name="LaunchArgumentsBox" Header="Launch arguments" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
