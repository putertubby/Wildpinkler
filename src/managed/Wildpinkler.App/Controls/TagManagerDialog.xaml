<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Wildpinkler.App.Controls.TagManagerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Wildpinkler.App.Controls"
    Title="Manage tags"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel Spacing="16">
        <TextBlock Opacity="0.72" TextWrapping="Wrap"
                   Text="Tags group and filter mods across the app. Add your own or remove the defaults; removing a tag does not strip it from mods already tagged with it." />
        <controls:TagInputBox x:Name="TagsInput" Header="Tags"
                              PlaceholderText="Type a tag, then Enter"
                              TagsChanged="TagsInput_TagsChanged" />
        <Button x:Name="ResetButton" Style="{StaticResource RowActionButtonStyle}"
                HorizontalAlignment="Left" Content="Reset to defaults"
                Click="ResetButton_Click" />
    </StackPanel>
</ContentDialog>
