<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Wildpinkler.App.Controls.FomodInstallWizardDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Install mod"
    PrimaryButtonText="Next"
    SecondaryButtonText="Back"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    SecondaryButtonClick="ContentDialog_SecondaryButtonClick"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel Spacing="12">
        <InfoBar x:Name="WarningsBar" Severity="Warning" IsOpen="False" IsClosable="True"
                 Title="Some install rules could not be fully understood" />

        <TextBlock x:Name="StepHeader" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />

        <!-- One row per install step, plus a final summary row. The ListView virtualizes its
             rows, so mods with hundreds of steps stay responsive. -->
        <ListView x:Name="StepList" SelectionMode="Single"
                  SelectionChanged="StepList_SelectionChanged"
                  MaxHeight="420" IsItemClickEnabled="True">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,6,16,6">
                        <TextBlock Text="{Binding Title}" FontSize="15"
                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Subtitle}" Opacity="0.72" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectionSummary}" Opacity="0.55"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Interactive editor for the active step: one section per group, written straight into the step draft. -->
        <StackPanel x:Name="EditorHost" Spacing="10" />

        <TextBlock x:Name="ErrorText" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
