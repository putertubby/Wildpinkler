<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Wildpinkler.App.Controls.FomodInstallWizardDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Install mod"
    PrimaryButtonText="Next"
    SecondaryButtonText="Back"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    SecondaryButtonClick="ContentDialog_SecondaryButtonClick"
    MinWidth="560"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel Spacing="12">
        <InfoBar x:Name="WarningsBar" Severity="Warning" IsOpen="False" IsClosable="True"
                 Title="Some install rules could not be fully understood" />

        <TextBlock x:Name="StepHeader" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />

        <!-- One row per install step, plus a final summary row. The ListView virtualizes its
             rows, so mods with hundreds of steps stay responsive. -->
        <ListView x:Name="StepList" SelectionMode="Single"
                  SelectionChanged="StepList_SelectionChanged"
                  MaxHeight="420" IsItemClickEnabled="True">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,6,16,6">
                        <TextBlock Text="{Binding Title}" FontSize="15"
                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Subtitle}" Opacity="0.72" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectionSummary}" Opacity="0.55"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Interactive editor for the active step: one section per group, written straight into the
             step draft. The ScrollViewer bounds the editor so dense steps (many groups or plugins)
             get a scrollbar instead of squeezing the dialog's buttons out of view. -->
        <ScrollViewer MaxHeight="360"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="EditorHost" Spacing="10" />
        </ScrollViewer>

        <!-- Destination choice, shown only on the summary step. This base is the TARGET FOLDER
             (default: the game's PluginDataFolder): every file's FOMOD destination is relative
             to it (an empty destination places files directly in the base, a non-empty one
             nests under it, e.g. "SKSE" -> "Data/SKSE"). It is also used for the reuse
             signature, the recorded install path (install root + base), and the remembered
             LastInstallPath. -->
        <StackPanel x:Name="DestinationSection" Spacing="8" Visibility="Collapsed">
            <TextBlock Opacity="0.72" TextWrapping="Wrap"
                       Text="Destination base for this install (files are placed under this folder; the mod's install rules decide where inside it). Choosing a different base creates a separate installation of this mod." />
            <TextBox x:Name="DestinationBox" Header="Relative destination path"
                     PlaceholderText="e.g. Data" TextChanged="DestinationBox_TextChanged" />
            <CheckBox x:Name="RememberPathCheck"
                      Content="Remember this path for future installs of this mod" />
            <TextBlock x:Name="DestinationErrorText"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
