<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Wildpinkler.App.Controls.FomodInstallWizardDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Install mod"
    PrimaryButtonText="Next"
    SecondaryButtonText="Back"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    SecondaryButtonClick="ContentDialog_SecondaryButtonClick"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel Spacing="12">
        <InfoBar x:Name="WarningsBar" Severity="Warning" IsOpen="False" IsClosable="True"
                 Title="Some install rules could not be fully understood" />

        <TextBlock x:Name="StepTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />

        <ScrollViewer x:Name="StepScroller" MaxHeight="420" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
            <StackPanel x:Name="GroupsHost" Spacing="16" />
        </ScrollViewer>

        <StackPanel x:Name="SummaryHost" Spacing="8" Visibility="Collapsed">
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Ready to install" />
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Opacity="0.72" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
