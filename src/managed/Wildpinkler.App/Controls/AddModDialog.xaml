<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Wildpinkler.App.Controls.AddModDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Wildpinkler.App.Models"
    Title="Add mod to plan"
    PrimaryButtonText="Add to plan"
    SecondaryButtonText="Add archive"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ScrollViewer MaxHeight="420" Padding="0,0,16,0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.85" TextWrapping="Wrap"
                       Text="Add a mod to this plan from your library (select it below), or cancel and use 'Add archive' to import a local archive first." />

            <TextBox x:Name="SearchBox" PlaceholderText="Search" AcceptsReturn="True"
                     TextChanged="SearchBox_TextChanged" />

            <ListView x:Name="ModList" SelectionMode="Single" Height="230"
                      SelectionChanged="ModList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ModEntry">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextTrimming="CharacterEllipsis"
                                       Text="{Binding Version}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyText" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"
                       Text="No mods in the library yet." Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
