<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Wildpinkler.App.Controls.ModEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Wildpinkler.App.Controls"
    Title="Mod"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ScrollViewer MaxHeight="560" Padding="0,0,16,0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20">
            <TextBlock x:Name="ArchiveHeader" Opacity="0.68" TextWrapping="Wrap" Visibility="Collapsed" />

            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SectionLabelStyle}" Text="GENERAL" />
                <TextBox x:Name="NameBox" Header="Mod name" TextChanged="Field_Changed" />
                <TextBox x:Name="VersionBox" Header="Version" TextChanged="Field_Changed" />
                <TextBox x:Name="AuthorBox" Header="Author" />
                <TextBox x:Name="WebsiteBox" Header="Website" />
                <TextBox x:Name="DescriptionBox" Header="Description" AcceptsReturn="True" Height="88" TextWrapping="Wrap" />
            </StackPanel>

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" />

            <controls:GameAssociationPicker x:Name="GamePicker" SelectionChanged="Field_Changed" />

            <StackPanel x:Name="FomodSection" Spacing="6" Visibility="Collapsed">
                <Border Padding="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                    <StackPanel Spacing="6">
                        <TextBlock FontWeight="SemiBold" Text="FOMOD" />
                        <TextBlock x:Name="FomodStateText" Opacity="0.68" TextWrapping="Wrap" />
                        <TextBlock x:Name="FomodGroups" Opacity="0.68" TextWrapping="Wrap" />
                        <TextBlock x:Name="FomodSteps" Opacity="0.68" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock x:Name="ArchivePathText" Opacity="0.5" IsTextSelectionEnabled="True" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
