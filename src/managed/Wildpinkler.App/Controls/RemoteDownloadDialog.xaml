<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Wildpinkler.App.Controls.RemoteDownloadDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Download this mod?"
    PrimaryButtonText="Download"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">
            <StackPanel Spacing="2">
                <TextBlock x:Name="ModNameText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="ModByText" Opacity="0.68" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" />

            <InfoBar x:Name="GameInfoBar" IsOpen="False" IsClosable="False" />

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" />

            <Grid RowSpacing="8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource SectionLabelStyle}" Text="FILE" />
                <TextBlock x:Name="FileNameText" Grid.Column="1" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Style="{StaticResource SectionLabelStyle}" Text="VERSION" />
                <TextBlock x:Name="VersionText" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Style="{StaticResource SectionLabelStyle}" Text="SIZE" />
                <TextBlock x:Name="SizeText" Grid.Row="2" Grid.Column="1" />
                <TextBlock Grid.Row="3" Style="{StaticResource SectionLabelStyle}" Text="CATEGORY" />
                <TextBlock x:Name="CategoryText" Grid.Row="3" Grid.Column="1" />
                <TextBlock Grid.Row="4" Style="{StaticResource SectionLabelStyle}" Text="UPLOADED" />
                <TextBlock x:Name="UploadedText" Grid.Row="4" Grid.Column="1" />
                <TextBlock Grid.Row="5" Style="{StaticResource SectionLabelStyle}" Text="SITE" />
                <TextBlock x:Name="SiteText" Grid.Row="5" Grid.Column="1" TextWrapping="Wrap" />
            </Grid>

            <CheckBox x:Name="DoNotAskCheckBox" Content="Always download without asking" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
