<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wildpinkler.App.Controls.MergedViewSection"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource ContentCardStyle}" Padding="8">
        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
            <Expander.Header>
                <Grid ColumnSpacing="10" Padding="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="140" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{x:Bind ViewName, Mode=OneWay}" />
                        <TextBlock Opacity="0.62" TextTrimming="CharacterEllipsis" Text="{x:Bind MountPath, Mode=OneWay}"
                                   ToolTipService.ToolTip="{x:Bind MountPath, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Opacity="0.62" FontSize="11"
                               Text="{x:Bind BranchCountText, Mode=OneWay}" />
                    <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,2" CornerRadius="4"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}">
                        <TextBlock FontSize="11" Opacity="0.72" Text="{x:Bind AccessLabel, Mode=OneWay}" />
                    </Border>
                    <Border Grid.Column="3" VerticalAlignment="Center" Padding="8,2" CornerRadius="4"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}">
                        <TextBlock FontSize="11" Opacity="0.72" Text="{x:Bind SourceLabel, Mode=OneWay}" />
                    </Border>
                </Grid>
            </Expander.Header>
                <ContentPresenter Content="{x:Bind Body, Mode=OneWay}" />
        </Expander>
    </Border>
</UserControl>