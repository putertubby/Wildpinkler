<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wildpinkler.App.Controls.AssistantPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:agent="using:Wildpinkler.App.Agent"
    MinWidth="280">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1,0,0,0"
          Padding="12"
          RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Assistant"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Close" Click="Close_Click"
                    AutomationProperties.Name="Close the assistant pane" />
        </Grid>

        <ListView x:Name="TranscriptList"
                  Grid.Row="1"
                  SelectionMode="None"
                  IsItemClickEnabled="False"
                  AutomationProperties.Name="Conversation">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="agent:ChatMessage">
                    <StackPanel Spacing="2" Padding="0,4">
                        <TextBlock Opacity="0.62" Text="{x:Bind Role}" />
                        <TextBlock TextWrapping="Wrap" IsTextSelectionEnabled="True" Text="{x:Bind Content}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <InfoBar x:Name="StatusBar" Grid.Row="2" IsClosable="False" />

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PromptBox"
                     PlaceholderText="Ask about your profiles and mods"
                     AcceptsReturn="False"
                     AutomationProperties.Name="Message to the assistant"
                     KeyDown="PromptBox_KeyDown" />
            <Button Grid.Column="1" Content="Send" Click="Send_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    AutomationProperties.Name="Send the message" />
        </Grid>
    </Grid>
</UserControl>
