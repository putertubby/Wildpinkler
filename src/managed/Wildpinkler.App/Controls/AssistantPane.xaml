<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wildpinkler.App.Controls.AssistantPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:agent="using:Wildpinkler.App.Agent"
    xmlns:controls="using:Wildpinkler.App.Controls"
    MinWidth="280">

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="StopAccelerator_Invoked" />
    </UserControl.KeyboardAccelerators>

    <UserControl.Resources>
        <DataTemplate x:Key="UserEntryTemplate" x:DataType="agent:ChatEntry">
            <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="24,4,0,4"
                    HorizontalAlignment="Right">
                <StackPanel Spacing="6">
                    <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    <Button Content="Edit"
                            Tag="{x:Bind Id}"
                            Click="EditMessage_Click"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AssistantEntryTemplate" x:DataType="agent:ChatEntry">
            <controls:AssistantMarkdown Text="{x:Bind Text, Mode=OneWay}"
                                         Margin="0,4,24,4"
                                         AutomationProperties.Name="Assistant response" />
        </DataTemplate>

        <DataTemplate x:Key="ToolEntryTemplate" x:DataType="agent:ChatEntry">
            <Expander HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Margin="0,4"
                      IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing Width="16"
                                      Height="16"
                                      IsActive="{x:Bind IsStreaming, Mode=OneWay}"
                                      AutomationProperties.Name="Action in progress" />
                        <TextBlock Text="{x:Bind Header, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Expander.Header>
                <TextBlock Text="{x:Bind Detail, Mode=OneWay}"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True"
                           FontFamily="Consolas"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </Expander>
        </DataTemplate>

        <DataTemplate x:Key="ApprovalEntryTemplate" x:DataType="agent:ChatEntry">
            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,4">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind Header, Mode=OneWay}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Detail, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                Visibility="{x:Bind IsAwaitingAnswer, Mode=OneWay}">
                        <Button Content="Run"
                                Tag="{x:Bind Id}"
                                Click="Approve_Click" />
                        <Button Content="Don't run"
                                Tag="{x:Bind Id}"
                                Click="Decline_Click" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="NoticeEntryTemplate" x:DataType="agent:ChatEntry">
            <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                       TextWrapping="Wrap"
                       Margin="0,4"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </DataTemplate>

        <controls:ChatEntryTemplateSelector x:Key="EntryTemplates"
                                            User="{StaticResource UserEntryTemplate}"
                                            Assistant="{StaticResource AssistantEntryTemplate}"
                                            Tool="{StaticResource ToolEntryTemplate}"
                                            Approval="{StaticResource ApprovalEntryTemplate}"
                                            Notice="{StaticResource NoticeEntryTemplate}" />
    </UserControl.Resources>

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1,0,0,0"
          Padding="12"
          RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Assistant"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="4,0"
                    AutomationProperties.Name="{x:Bind Model.CurrentModeDescription, Mode=OneWay}"
                    ToolTipService.ToolTip="Change assistant mode">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{x:Bind Model.CurrentModeLabel, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <FontIcon Glyph="&#xE70D;"
                              FontSize="10"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              VerticalAlignment="Center" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout Opening="OptionsFlyout_Opening">
                        <RadioMenuFlyoutItem x:Name="ChatModeItem" Text="Chat only"
                                             GroupName="AssistantMode" Click="Mode_Click" />
                        <RadioMenuFlyoutItem x:Name="AskFirstModeItem" Text="Ask before every action"
                                             GroupName="AssistantMode" Click="Mode_Click" />
                        <RadioMenuFlyoutItem x:Name="AgentModeItem" Text="Look things up freely"
                                             GroupName="AssistantMode" Click="Mode_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <ProgressRing Grid.Column="2"
                          Width="16" Height="16"
                          VerticalAlignment="Center"
                          IsActive="{x:Bind Model.IsBusy, Mode=OneWay}"
                          AutomationProperties.Name="The assistant is working" />
            <Button Grid.Column="3"
                    Background="Transparent"
                    BorderThickness="0"
                    AutomationProperties.Name="More assistant options"
                    ToolTipService.ToolTip="More assistant options">
                <FontIcon Glyph="&#xE712;" />
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Clear conversation" Click="ClearConversation_Click" />
                        <MenuFlyoutItem Text="Regenerate last answer" Click="Regenerate_Click" />
                        <MenuFlyoutItem Text="Assistant settings" Click="OpenSettings_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Button Grid.Column="4"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="Close_Click"
                    AutomationProperties.Name="Close the assistant pane"
                    ToolTipService.ToolTip="Close the assistant pane">
                <FontIcon Glyph="&#xE711;" />
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <ListView x:Name="TranscriptList"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      ItemTemplateSelector="{StaticResource EntryTemplates}"
                      AutomationProperties.Name="Conversation">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        MaxWidth="280"
                        Spacing="8"
                        IsHitTestVisible="False"
                        Visibility="{x:Bind Model.IsEmpty, Mode=OneWay}">
                <FontIcon Glyph="&#xE99A;"
                          FontSize="24"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="No conversation yet"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind Model.EmptyStateMessage, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <StackPanel Spacing="4" Margin="0,8,0,0">
                    <Button Content="Why will my game not launch?"
                        Tag="Why will my game not launch?"
                        Click="Starter_Click" />
                    <Button Content="Check my profile dependencies"
                        Tag="Check my profile dependencies"
                        Click="Starter_Click" />
                    <Button Content="Which tracked mods have updates?"
                        Tag="Which tracked mods have updates?"
                        Click="Starter_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <InfoBar x:Name="StatusBar" Grid.Row="2" IsClosable="False">
            <InfoBar.ActionButton>
                <Button x:Name="StatusActionButton"
                        Visibility="Collapsed"
                        Click="StatusAction_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="PromptBox"
                            PlaceholderText="Ask about your profiles and mods; type @ to reference one"
                            MaxHeight="120"
                            AutomationProperties.Name="Message to the assistant"
                            TextChanged="PromptBox_TextChanged"
                            SuggestionChosen="PromptBox_SuggestionChosen"
                            PreviewKeyDown="PromptBox_PreviewKeyDown" />
            <Grid Grid.Column="1" VerticalAlignment="Bottom">
                <Button x:Name="SendButton"
                        Content="Send"
                        Click="Send_Click"
                        IsEnabled="{x:Bind Model.CanSend, Mode=OneWay}"
                        Visibility="{x:Bind Model.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                        Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.Name="Send the message" />
                <Button x:Name="StopButton"
                        Content="Stop"
                        Click="Stop_Click"
                        Visibility="{x:Bind Model.IsBusy, Mode=OneWay}"
                        AutomationProperties.Name="Stop the assistant" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
