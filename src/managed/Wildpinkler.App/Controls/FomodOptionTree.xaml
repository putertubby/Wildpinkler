<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wildpinkler.App.Controls.FomodOptionTree"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Wildpinkler.App.Controls">

    <StackPanel Spacing="8">
        <TextBlock x:Name="WarningText" Opacity="0.72" TextWrapping="Wrap"
                   Visibility="Collapsed" />
        <ListView x:Name="TreeList" SelectionMode="None"
                  MaxHeight="360"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:FomodOptionNode">
                    <Grid ColumnSpacing="8" Margin="{x:Bind Indent}" Tag="{x:Bind}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Containers (steps/groups) show a chevron; leaves show nothing here -->
                        <FontIcon
                                  Glyph="{x:Bind ExpandGlyph}"
                                  FontSize="12" VerticalAlignment="Center"
                                  Visibility="{Binding IsContainer, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <!-- Leaf: checkbox; container: none -->
                        <CheckBox Grid.Column="1"
                                  VerticalAlignment="Center"
                                  IsEnabled="{x:Bind IsEnabled}"
                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  Checked="Check_Changed"
                                  Unchecked="Check_Changed"
                                  Visibility="{Binding IsContainer, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <!-- Plugin preview image (leaf rows that carry one); collapsed when absent. -->
                                <Image Source="{x:Bind Thumbnail}"
                                       Width="28" Height="28" Stretch="Uniform"
                                       VerticalAlignment="Center"
                                       Visibility="{x:Bind HasThumbnail, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock Text="{x:Bind Name}"
                                           FontWeight="{x:Bind FontWeight}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <Border
                                        Visibility="{x:Bind ShowTypeBadge, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="3" Padding="4,1">
                                    <TextBlock Text="{x:Bind TypeText}" FontSize="11"
                                               Foreground="{ThemeResource MetadataTextBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{x:Bind Description}" Opacity="0.72"
                                       FontSize="12" TextWrapping="Wrap"
                                       Visibility="{x:Bind HasDescription, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" Opacity="0.68"
                                   FontSize="12" VerticalAlignment="Center"
                                   Text="{x:Bind GroupRuleText}"
                                   Visibility="{x:Bind HasGroupRule, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="ValidationText"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
