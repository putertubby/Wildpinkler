<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Wildpinkler.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Wildpinkler">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Static tagline; no longer tracks the active profile/game. -->
        <TitleBar x:Name="AppTitleBar"
                  Grid.Row="0"
                  Title="Wildpinkler"
                  Subtitle="the mod juggler"
                  IsBackButtonVisible="{x:Bind ContentFrame.CanGoBack, Mode=OneWay}"
                  BackRequested="AppTitleBar_BackRequested"
                  IsPaneToggleButtonVisible="True"
                  PaneToggleRequested="AppTitleBar_PaneToggleRequested" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <NavigationView
                x:Name="NavView"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="False"
                IsSettingsVisible="True"
                ItemInvoked="NavView_ItemInvoked">
                <NavigationView.FooterMenuItems>
                    <NavigationViewItem x:Name="AssistantNavItem"
                                        Content="Assistant"
                                        Tag="Assistant"
                                        AutomationProperties.Name="Toggle the assistant pane"
                                        ToolTipService.ToolTip="Toggle the assistant pane">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE99A;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.FooterMenuItems>
                <Frame x:Name="ContentFrame" />
            </NavigationView>

            <!-- Populated on demand; the pane stays out of the visual tree until it is opened. -->
            <ContentPresenter x:Name="AssistantHost"
                              Grid.Column="1"
                              Width="360"
                              Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
