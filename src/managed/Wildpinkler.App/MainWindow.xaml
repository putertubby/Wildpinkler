<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Wildpinkler.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controlsToolkit="using:CommunityToolkit.WinUI.Controls"
    Title="Wildpinkler">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Static tagline; no longer tracks the active profile/game. -->
        <TitleBar x:Name="AppTitleBar"
                  Grid.Row="0"
                  Title="Wildpinkler"
                  Subtitle="the mod juggler"
                  IsBackButtonVisible="{x:Bind ContentFrame.CanGoBack, Mode=OneWay}"
                  BackRequested="AppTitleBar_BackRequested"
                  IsPaneToggleButtonVisible="True"
                  PaneToggleRequested="AppTitleBar_PaneToggleRequested" />

        <Grid x:Name="ShellGrid" Grid.Row="1" SizeChanged="ShellGrid_SizeChanged" KeyboardAcceleratorPlacementMode="Hidden">
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="F6" Invoked="CycleRegion_Invoked" />
                <KeyboardAccelerator Key="F6" Modifiers="Shift" Invoked="CycleRegion_Invoked" />
            </Grid.KeyboardAccelerators>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="AssistantColumn" Width="0" MaxWidth="720" />
            </Grid.ColumnDefinitions>

            <NavigationView
                x:Name="NavView"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="False"
                IsSettingsVisible="True"
                AutomationProperties.Name="Navigation"
                ItemInvoked="NavView_ItemInvoked">
                <NavigationView.FooterMenuItems>
                    <NavigationViewItem x:Name="AssistantNavItem"
                                        Content="Assistant"
                                        Tag="Assistant"
                                        SelectsOnInvoked="False"
                                        AutomationProperties.Name="Toggle the assistant pane"
                                        ToolTipService.ToolTip="Toggle the assistant pane">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE99A;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.FooterMenuItems>
                <Frame x:Name="ContentFrame" AutomationProperties.Name="Page content" />
            </NavigationView>

            <controlsToolkit:GridSplitter x:Name="AssistantSplitter" Grid.Column="1" Width="8"
                                          HorizontalAlignment="Stretch"
                                          ResizeDirection="Columns" ResizeBehavior="BasedOnAlignment"
                                          Visibility="Collapsed"
                                          AutomationProperties.Name="Resize the assistant pane" />

            <!-- Populated on demand; the pane stays out of the visual tree until it is opened. -->
            <ContentPresenter x:Name="AssistantHost"
                              Grid.Column="2"
                              AutomationProperties.Name="Assistant"
                              Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
