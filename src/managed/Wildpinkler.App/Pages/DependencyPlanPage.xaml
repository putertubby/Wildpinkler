<?xml version="1.0" encoding="utf-8"?>
<pages:PageBase
    x:Class="Wildpinkler.App.Pages.DependencyPlanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:Wildpinkler.App.Pages"
    xmlns:models="using:Wildpinkler.App.Models"
    xmlns:controls="using:Wildpinkler.App.Controls"
    xmlns:controlsToolkit="using:CommunityToolkit.WinUI.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <pages:PageBase.Resources>
        <Style x:Key="RowButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="RowActionsButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </pages:PageBase.Resources>

    <Grid Padding="{StaticResource PageContentPadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Install with dependencies" />
                <TextBlock x:Name="ProfileTitle" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75" />
            </StackPanel>
            <CommandBar Grid.Column="1" DefaultLabelPosition="Right" HorizontalAlignment="Right" Background="Transparent">
                <AppBarButton x:Name="ResolveAllButton" Icon="OpenFile" Label="Open pending pages"
                             ToolTipService.ToolTip="Open the site pages for every mod still awaiting your download, in order"
                             Click="ResolveAll_Click" />
                <AppBarButton x:Name="SaveListButton" Icon="Save" Label="Save as mod list"
                             ToolTipService.ToolTip="Save this plan as a portable mod list for later builds"
                             Click="SaveList_Click" />
                <CommandBar.SecondaryCommands>
                    <AppBarButton Icon="Edit" Label="Add mod"
                                 ToolTipService.ToolTip="Add a mod from your library, or import an archive, as a row in this plan"
                                 Click="AddMod_Click" />
                    <AppBarButton Icon="Sync" Label="Resolve changes"
                                 ToolTipService.ToolTip="Re-run dependency resolution for the rows you changed; rows you haven't changed keep their state"
                                 Click="ResolveChanges_Click" />
                    <AppBarButton Icon="Redo" Label="Re-resolve"
                                 ToolTipService.ToolTip="Resolve the dependency tree again against the current site data"
                                 Click="ReResolve_Click" />
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <InfoBar x:Name="PlanInfoBar" Grid.Row="1" IsOpen="False" IsClosable="False" />

        <Border x:Name="DecisionsStrip" Grid.Row="2" Style="{StaticResource ContentCardStyle}" Padding="12,8"
                Visibility="Collapsed">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                           Text="Applied decisions:" VerticalAlignment="Center" />
                <ItemsControl Grid.Column="1" ItemsSource="{x:Bind DecisionItems, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:WrapPanel ItemSpacing="8" LineSpacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:PlanDecisionStripItem">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,12,2" VerticalAlignment="Center">
                                <Border Style="{StaticResource FilterChipStyle}" Padding="8,2,4,2">
                                    <Button Style="{StaticResource ChipRemoveButtonStyle}" Tag="{x:Bind}"
                                            Click="InspectDecision_Click"
                                            ToolTipService.ToolTip="{x:Bind Description, Mode=OneTime}"
                                            AutomationProperties.Name="{x:Bind InspectAutomationName, Mode=OneTime}">
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Description, Mode=OneTime}" />
                                    </Button>
                                </Border>
                                <Button Style="{StaticResource RowButtonStyle}" Tag="{x:Bind}" Click="UndoDecision_Click"
                                        ToolTipService.ToolTip="Undo this applied decision"
                                        AutomationProperties.Name="{x:Bind UndoAutomationName, Mode=OneTime}">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="ClearDecisionsButton" Grid.Column="2" Style="{StaticResource RowButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Visibility="{x:Bind HasDecisions, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                        ToolTipService.ToolTip="Remove every applied decision and start the plan over"
                        AutomationProperties.Name="Clear all applied decisions"
                        Click="ClearAllDecisions_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Clear all" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid x:Name="ListDetailsGrid" Grid.Row="3" Loaded="ListDetailsGrid_Loaded" SizeChanged="ListDetailsGrid_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumnDef" Width="*" MinWidth="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="DetailsColumnDef" Width="0" MinWidth="0" MaxWidth="640" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource ContentCardStyle}" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="{StaticResource SectionHeaderPadding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Plan items" VerticalAlignment="Center" />
                        <TextBlock x:Name="PlanSummary" Grid.Column="1" Opacity="0.8" Text="{Binding SummaryText}"
                                   TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <ScrollViewer x:Name="SectionsList" Grid.Row="1" Padding="0,4,0,4"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{x:Bind Sections, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:PlanSectionView">
                                <Grid x:DataType="models:PlanSectionView">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Button Grid.Row="0" Style="{StaticResource RowButtonStyle}"
                                           Tag="{x:Bind}" Click="SectionHeader_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind Chevron, Mode=OneWay}" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" VerticalAlignment="Center"
                                                       Text="{x:Bind CountText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>

                                    <StackPanel Grid.Row="1" Padding="4,2,4,6"
                                                Visibility="{x:Bind IsExpanded, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                        <ItemsRepeater ItemsSource="{x:Bind Entries}">
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="models:PlanRowContainer">
                                                    <Border x:Name="RowBorder" Padding="4,0"
                                                            Background="{x:Bind IsSelected, Converter={StaticResource BoolToHighlightBrushConverter}, Mode=OneWay}">
                                                        <Grid ColumnSpacing="8" Padding="4,2"
                                                              Opacity="{x:Bind Entry.DerivedState, Converter={StaticResource RowStatusToOpacityConverter}, Mode=OneWay}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0" IsChecked="{x:Bind Entry.IsSelected, Mode=TwoWay}" VerticalAlignment="Center"
                                                                      AutomationProperties.Name="{x:Bind IncludeAutomationName, Mode=OneWay}"
                                                                      ToolTipService.ToolTip="Include this mod in the install"
                                                                      IsEnabled="{x:Bind Entry.DerivedState, Converter={StaticResource NotExcludedConverter}, Mode=OneWay}" />
                                                            <Button Grid.Column="1" Style="{StaticResource RowButtonStyle}"
                                                                    Tag="{x:Bind}" Click="Row_Click">
                                                                <Grid ColumnSpacing="10" Padding="8,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" FontSize="13"
                                                                                       Foreground="{x:Bind Entry.DerivedState, Converter={StaticResource PlanStatusToBrushConverter}, Mode=OneWay}"
                                                                                       Text="{x:Bind Entry.DerivedStateGlyph, Mode=OneWay}" VerticalAlignment="Center" />
                                                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                                                                       Foreground="{x:Bind Entry.DerivedState, Converter={StaticResource PlanStatusToBrushConverter}, Mode=OneWay}"
                                                                                       Text="{x:Bind Entry.DerivedStateText, Mode=OneWay}" VerticalAlignment="Center" />
                                                                            <Border Style="{StaticResource FilterChipStyle}" Padding="6,0,6,0" VerticalAlignment="Center"
                                                                                    Visibility="{x:Bind Entry.KindText, Converter={StaticResource NonNullToVisibilityConverter}, Mode=OneWay}">
                                                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Entry.KindText, Mode=OneWay}" />
                                                                            </Border>
                                                                        </StackPanel>
                                                                        <TextBlock Text="{x:Bind Entry.Name, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.85" TextWrapping="Wrap"
                                                                                   Text="{x:Bind Entry.RowSubtitleText, Mode=OneWay}" />
                                                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75" TextWrapping="Wrap"
                                                                                   Text="{x:Bind CoveredRequirementsText, Mode=OneWay}"
                                                                                   Visibility="{x:Bind CoveredRequirementsText, Converter={StaticResource NonNullToVisibilityConverter}, Mode=OneWay}" />
                                                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                                                                   Text="{x:Bind Entry.ReplacementText, Mode=OneWay}"
                                                                                   Visibility="{x:Bind Entry.ReplacementText, Converter={StaticResource NonNullToVisibilityConverter}, Mode=OneWay}" />
                                                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap"
                                                                                   Text="{x:Bind RecommendationText, Mode=OneWay}"
                                                                                   Visibility="{x:Bind RecommendationText, Converter={StaticResource NonNullToVisibilityConverter}, Mode=OneWay}" />
                                                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap"
                                                                                   Text="{x:Bind Entry.StatusDetail, Mode=OneWay}"
                                                                                   Visibility="{x:Bind Entry.StatusDetail, Converter={StaticResource NonNullToVisibilityConverter}, Mode=OneWay}" />
                                                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.85" TextWrapping="Wrap"
                                                                                   Text="{x:Bind Entry.FoldedInText, Mode=OneWay}"
                                                                                   Visibility="{x:Bind Entry.FoldedInText, Converter={StaticResource NonNullToVisibilityConverter}, Mode=OneWay}" />
                                                                        <ProgressBar Width="180" HorizontalAlignment="Left"
                                                                                     Value="{x:Bind Entry.DownloadProgress, Mode=OneWay}"
                                                                                     Maximum="1"
                                                                                     Visibility="{x:Bind Entry.IsDownloading, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                                                        <ItemsControl ItemsSource="{x:Bind Chips, Mode=OneWay}" Margin="0,2,0,0">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="models:RequirementChip">
                                                                                    <Button Style="{StaticResource RowButtonStyle}"
                                                                                            Tag="{x:Bind}" Click="ResolveChip_Click"
                                                                                            HorizontalAlignment="Left" Margin="4,2">
                                                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                                            <Border Style="{StaticResource FilterChipStyle}" Padding="6,0,6,0">
                                                                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Text, Mode=OneTime}" />
                                                                                            </Border>
                                                                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"
                                                                                                   Text="resolve this requirement" VerticalAlignment="Center" />
                                                                                        </StackPanel>
                                                                                    </Button>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" VerticalAlignment="Center"
                                                                               Text="{x:Bind Entry.FileSizeText, Mode=OneWay}" />
                                                                </Grid>
                                                            </Button>
                                                            <Button Grid.Column="2" Style="{StaticResource RowActionsButtonStyle}"
                                                                    Tag="{x:Bind}" Click="RowActions_Click"
                                                                    AutomationProperties.Name="{x:Bind ActionsAutomationName, Mode=OneWay}"
                                                                    ToolTipService.ToolTip="More actions for this plan row">
                                                                <FontIcon Glyph="&#xE712;" FontSize="14" />
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock x:Name="EmptyState" Grid.Row="1" IsHitTestVisible="False"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="480"
                               Text="Resolving dependencies…"
                               Visibility="Collapsed" />
                </Grid>
            </Border>

            <controlsToolkit:GridSplitter x:Name="DetailsSplitter" Grid.Column="1" Width="8"
                                          HorizontalAlignment="Stretch"
                                          ResizeDirection="Columns" ResizeBehavior="BasedOnAlignment"
                                          Visibility="Collapsed"
                                          AutomationProperties.Name="Resize details pane" />

            <Border x:Name="DetailsCard" Grid.Column="2" Margin="12,0,0,0" Padding="16"
                    Visibility="Collapsed"
                    Style="{StaticResource ContentCardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailsPanel" Spacing="12">
                        <Button x:Name="BackToListButton" HorizontalAlignment="Left" Visibility="Collapsed"
                                Click="BackToList_Click" AutomationProperties.Name="Back to list">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72B;" FontSize="14" />
                                <TextBlock Text="Back to list" />
                            </StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Details" />
                        <TextBlock x:Name="DetailsName" TextWrapping="Wrap" />
                        <StackPanel x:Name="DetailsMeta" Spacing="2">
                            <TextBlock x:Name="DetailsAuthor" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="DetailsVersion" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="DetailsIdentity" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailsPresence" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailsSize" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="DetailsStats" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="DetailsUpdated" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="DetailsSummaryBlock" Spacing="4">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Text="About:" />
                            <TextBlock x:Name="DetailsSummary" TextWrapping="Wrap" Opacity="0.88" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Text="Why it's here:" />
                            <TextBlock x:Name="DetailsChain" TextWrapping="Wrap" Opacity="0.88" />
                        </StackPanel>
                        <StackPanel Spacing="4" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Text="Requirement notes:" />
                            <TextBlock x:Name="DetailsNotes" TextWrapping="Wrap" Opacity="0.88" />
                        </StackPanel>
                        <StackPanel x:Name="ConflictBlock" Spacing="4" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Text="Conflict:" />
                            <TextBlock x:Name="DetailsConflict" TextWrapping="Wrap" Opacity="0.88" />
                        </StackPanel>
                        <StackPanel x:Name="OverrideBlock" Spacing="4" Visibility="Collapsed">
                            <TextBlock x:Name="DetailsOverrideLabel" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Text="Your decision:" />
                            <TextBlock x:Name="DetailsOverride" TextWrapping="Wrap" Opacity="0.88" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Text="File:" />
                            <TextBlock x:Name="DetailsFile" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel x:Name="FoldedInBlock" Spacing="8" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Text="Requirements satisfied by this mod:" />
                            <ListView x:Name="FoldedInList" SelectionMode="None" MaxHeight="160">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:FoldedInEntry">
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Text="Actions:" />
                            <StackPanel x:Name="DetailsActions" Spacing="8">
                            <Button x:Name="OpenPageButton" Content="Open site page" Click="OpenPage_Click" />
                            <Button x:Name="ExcludeButton" Content="Set aside" Click="Exclude_Click" />
                            <Button x:Name="UseDownloadButton" Content="Download from mod page" Click="UseDownload_Click"
                                   ToolTipService.ToolTip="Opens the mod page; the download Wildpinkler catches from there is matched to this row" />
                            <Button x:Name="RetryDownloadButton" Content="Retry download" Click="RetryDownload_Click" />
                            <Button x:Name="RetryFetchButton" Content="Retry lookup" Click="RetryFetch_Click"
                                   ToolTipService.ToolTip="Fetch the mod's site data again" />
                            <Button x:Name="UpdateButton" Content="Update to latest" Click="Update_Click"
                                   ToolTipService.ToolTip="Download and install the site's latest file for this mod" />
                            <Button x:Name="OpenSearchButton" Content="Find this mod" Click="OpenSearch_Click"
                                   ToolTipService.ToolTip="Opens a Nexus search for this mod's name so you can pick the right page" />
                            <Button x:Name="MatchLocalButton" Content="Identify or satisfy with…" Click="MatchLocal_Click"
                                   ToolTipService.ToolTip="Identify the requirement as a library mod or satisfy it with a mod already in this plan. The confirmed choice is remembered." />
                            <Button x:Name="ObsoleteButton" Content="Replace with…" Click="Obsolete_Click"
                                   ToolTipService.ToolTip="This mod is an already-present (possibly outdated) dependency: point it at a newer mod in the plan that covers it. The referenced mod is not installed." />
                            <Button x:Name="ReviewConflictButton" Content="View conflict" Click="ReviewConflict_Click"
                                   Visibility="Collapsed"
                                   ToolTipService.ToolTip="Show the mod this one conflicts with" />
                            <Button x:Name="IncludeButton" Content="Restore to plan" Click="Include_Click"
                                   Visibility="Collapsed"
                                   ToolTipService.ToolTip="Bring this excluded mod (and anything that depended on it) back into the plan" />
                            <Button x:Name="ResetButton" Content="Undo changes" Click="Reset_Click"
                                   Visibility="Collapsed"
                                   ToolTipService.ToolTip="Undo your changes to this row and return it to the state dependency resolution assigned" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="FileChoiceBlock" Spacing="8">
                            <ComboBox x:Name="FileChoiceCombo" DisplayMemberPath="FileName"
                                      SelectionChanged="FileChoiceCombo_SelectionChanged"
                                      ToolTipService.ToolTip="The file on the site whose version matches the requirement" />
                            <Button Content="Apply file" Click="ApplyFile_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource ContentCardStyle}">
            <Grid ColumnSpacing="16" Padding="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ActionSummary" VerticalAlignment="Center" Opacity="0.8" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CloseButton" Content="Close" Click="Close_Click" />
                    <Button x:Name="DownloadButton" Content="Download selected" Click="Download_Click" />
                    <Button x:Name="InstallButton" Content="Install downloaded" Click="Install_Click"
                           Style="{StaticResource AccentButtonStyle}"
                           ToolTipService.ToolTip="Installs the downloaded mods into the profile, one at a time, with their FOMOD/destination choices" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</pages:PageBase>
