<?xml version="1.0" encoding="utf-8"?>
<pages:PageBase
    x:Class="Wildpinkler.App.Pages.ProfileContentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:Wildpinkler.App.Pages"
    xmlns:models="using:Wildpinkler.App.Models"
    xmlns:controls="using:Wildpinkler.App.Controls"
    xmlns:controlsToolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:sys="using:System"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <pages:PageBase.Resources>
        <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource MetadataTextBrush}" />
            <Setter Property="Margin" Value="4,8,4,4" />
        </Style>
        <Style x:Key="RowActionButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </pages:PageBase.Resources>

    <Grid Padding="{StaticResource PageContentPadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <!-- 0: header (title + action bar) -->
            <RowDefinition Height="Auto" />
            <!-- 1: persistent page InfoBar -->
            <RowDefinition Height="Auto" />
            <!-- 2: resolving status bar -->
            <RowDefinition Height="Auto" />
            <!-- 3: decisions strip -->
            <RowDefinition Height="Auto" />
            <!-- 4: two-column body (row list | details) -->
            <RowDefinition Height="*" />
            <!-- 5: install action bar (progress + Apply changes / Cancel) -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Profile content" />
                <TextBlock x:Name="ProfileCaption" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75" />
            </StackPanel>
            <CommandBar Grid.Column="1" DefaultLabelPosition="Right" HorizontalAlignment="Right" Background="Transparent">
                <AppBarButton Icon="Add" Label="Add mod"
                             ToolTipService.ToolTip="Add a mod from the library to plan, conflict-check, and install"
                             Click="AddMod_Click" />
                <AppBarButton Icon="Download" Label="Download all"
                             ToolTipService.ToolTip="Download every 'To download' mod that has a remote identity (never automatic)"
                             Click="DownloadSelected_Click" />
                <AppBarButton Icon="Save" Label="Save as mod list"
                             ToolTipService.ToolTip="Save the selected plan mods as a shareable mod list"
                             Click="SaveAsModList_Click" />
                <AppBarButton Icon="Globe" Label="Open pending pages"
                             ToolTipService.ToolTip="Open the site page for every 'To download' mod that has no archive yet (free tier)"
                             Click="OpenPendingPages_Click" />
                <AppBarButton Icon="Sync" Label="Refresh info"
                             ToolTipService.ToolTip="Re-fetch remote metadata for the selected mod"
                             Click="RefreshSelected_Click" />
                <CommandBar.SecondaryCommands>
                    <AppBarButton x:Name="ResolveChangesButton" Icon="Sync" Label="Resolve changes"
                                 ToolTipService.ToolTip="Re-run dependency resolution for the rows you changed; rows you haven't changed keep their state"
                                 Click="ResolveChangesHeader_Click" />
                    <AppBarButton x:Name="ReResolveButton" Icon="Redo" Label="Re-resolve"
                                 ToolTipService.ToolTip="Resolve the dependency tree again against the current site data"
                                 Click="ReResolveHeader_Click" />
                    <AppBarButton Icon="Save" Label="Save plan"
                                 ToolTipService.ToolTip="Save this plan (selections, destinations, install options) for later"
                                 Click="SavePlan_Click" />
                    <AppBarButton Icon="Delete" Label="Discard plan"
                                 ToolTipService.ToolTip="Abandon this plan without changing the profile"
                                 Click="DiscardPlan_Click" />
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <!-- Persistent page InfoBar: one dismissible bar for page-level notices (replaces the old
             floating InfoBars that accumulated in the details pane). -->
        <InfoBar x:Name="PageInfoBar" Grid.Row="1" IsOpen="False" IsClosable="True"
                 Title="Profile content" HorizontalAlignment="Stretch" />

        <!-- Resolving status (Resolving state) -->
        <Border Grid.Row="2" Style="{StaticResource ContentCardStyle}" Padding="12,8"
                Visibility="Collapsed" x:Name="ResolvingBar">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing Width="16" Height="16" IsIndeterminate="True" />
                <TextBlock x:Name="ResolvingText" VerticalAlignment="Center"
                           Text="Resolving mod information…" />
            </StackPanel>
        </Border>

        <!-- Plan summary + decisions strip -->
        <StackPanel Grid.Row="3" Spacing="6">
            <!-- Workflow stepper: signposts the ordered plan → download → configure → review → apply flow. -->
            <StackPanel x:Name="WorkflowStepper" Orientation="Horizontal" Spacing="6" Padding="4,2">
                <Border x:Name="PhasePlanChip" Style="{StaticResource FilterChipStyle}" Padding="6,2">
                    <TextBlock Text="1. Plan" FontSize="11" />
                </Border>
                <TextBlock Text="›" FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
                <Border x:Name="PhaseDownloadChip" Style="{StaticResource FilterChipStyle}" Padding="6,2">
                    <TextBlock Text="2. Download" FontSize="11" />
                </Border>
                <TextBlock Text="›" FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
                <Border x:Name="PhaseConfigureChip" Style="{StaticResource FilterChipStyle}" Padding="6,2">
                    <TextBlock Text="3. Configure" FontSize="11" />
                </Border>
                <TextBlock Text="›" FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
                <Border x:Name="PhaseReviewChip" Style="{StaticResource FilterChipStyle}" Padding="6,2">
                    <TextBlock Text="4. Review &amp; apply" FontSize="11" />
                </Border>
            </StackPanel>
            <StackPanel x:Name="PlanSummaryPanel" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                <TextBlock x:Name="PlanSummaryTextBlock" Style="{StaticResource CaptionTextBlockStyle}"
                           Text="{x:Bind PlanSummaryText, Mode=OneWay}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="SelectedCountTextBlock" Style="{StaticResource CaptionTextBlockStyle}"
                           Opacity="0.7"
                           Text="{x:Bind SelectedCountText, Mode=OneWay}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <Border Style="{StaticResource ContentCardStyle}" Padding="12,8"
                    Visibility="Collapsed" x:Name="DecisionsStrip">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                               Text="Decisions:" VerticalAlignment="Center" />
                    <ItemsControl Grid.Column="1" ItemsSource="{x:Bind PlanDecisionItems, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:WrapPanel ItemSpacing="8" LineSpacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:PlanDecisionStripItem">
                                <Border Style="{StaticResource FilterChipStyle}" Padding="4,2,4,2" Margin="0,2,8,2">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button Style="{StaticResource RowActionButtonStyle}" Padding="4,0"
                                                HorizontalAlignment="Left"
                                                Click="PlanDecisionInspect_Click"
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="Show this decision in the plan">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{x:Bind Verb}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           FontSize="12" />
                                                <TextBlock Text="{x:Bind Description}" VerticalAlignment="Center"
                                                           FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                        <Button Content="Undo" Style="{StaticResource RowActionButtonStyle}"
                                                Padding="6,0" FontSize="11"
                                                Click="PlanDecisionUndo_Click"
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="Undo this decision and re-resolve" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Grid.Column="2" Content="Clear all" Style="{StaticResource RowActionButtonStyle}"
                            Click="PlanDecisionClearAll_Click"
                            ToolTipService.ToolTip="Clear every decision for this plan" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- Body: row list (left) + resizable details (right), with an empty state shown when
             there is nothing to list. The details pane is collapsible (select a row to open it,
             "Back to list" / deselect to close it) and resizable, consistent with the other
             list/details pages (Mods, Games, Downloads, Tools, Mod lists, Profiles). -->
        <Grid x:Name="ListDetailsGrid" Grid.Row="4"
              Loaded="ListDetailsGrid_Loaded" SizeChanged="ListDetailsGrid_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumnDef" Width="*" MinWidth="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="DetailsColumnDef" Width="360" MinWidth="280" MaxWidth="1200" />
            </Grid.ColumnDefinitions>

            <!-- Row list: filter bar (query + section) above the unified sections, each collapsible. -->
            <Grid Grid.Column="0" RowSpacing="6" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Filter bar: one query box (free text plus "#token" terms that match a tag or
                     a section name, e.g. #graphics / #download), a section dropdown, and one
                     segmented grouping control (State / Tag / A-Z). Active "#"-filters are shown
                     as removable chips so the user always sees what is filtering the list. -->
                <Grid Grid.Row="0" RowSpacing="4"
                      Visibility="{x:Bind FilterBarVisibility, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="ListFilterBox" Width="300" PlaceholderText="Filter mods (or #tag / #section)"
                                 TextChanged="ListFilterBox_TextChanged"
                                 Text="{x:Bind FilterQuery, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Choose how the list is grouped">
                            <Button x:Name="GroupStateButton" Style="{StaticResource FilterChipButtonStyle}" Padding="8,4"
                                    Content="State" Click="GroupingButton_Click"
                                    AutomationProperties.Name="Group by state" />
                            <Button x:Name="GroupTagButton" Style="{StaticResource FilterChipButtonStyle}" Padding="8,4"
                                    Content="Tag" Click="GroupingButton_Click"
                                    AutomationProperties.Name="Group by tag" />
                            <Button x:Name="GroupAlphaButton" Style="{StaticResource FilterChipButtonStyle}" Padding="8,4"
                                    Content="A–Z" Click="GroupingButton_Click"
                                    AutomationProperties.Name="Group alphabetically" />
                        </StackPanel>
                        <TextBlock x:Name="ListFilterCount" VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75" />
                        <Button Style="{StaticResource FilterChipButtonStyle}" Padding="8,4"
                                Content="Tags…" Click="ManageTags_Click"
                                ToolTipService.ToolTip="Manage the custom tags used on this profile"
                                AutomationProperties.Name="Manage tags" />
                    </StackPanel>

                    <!-- Active "#"-filters: each removable chip reflects one #token in the query. -->
                    <ItemsControl Grid.Row="1" x:Name="ActiveFilterChips"
                                  ItemsSource="{x:Bind ActiveFilterTokens, Mode=OneWay}"
                                  Visibility="{x:Bind HasActiveFilterTokens, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:WrapPanel ItemSpacing="6" LineSpacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sys:String">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Border Style="{StaticResource FilterChipStyle}" Padding="6,1">
                                        <TextBlock Text="#{x:Bind}" FontSize="11" />
                                    </Border>
                                    <Button Style="{StaticResource RowActionButtonStyle}" Padding="4,0"
                                            Content="✕" Click="RemoveFilterToken_Click" Tag="{x:Bind}"
                                            ToolTipService.ToolTip="Remove this #filter" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{x:Bind UnifiedSections, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="pages:UnifiedPlanSection">
                            <StackPanel Spacing="0"
                                       Visibility="{x:Bind SectionVisibility, Mode=OneWay}">
                                <!-- Section header: chevron + name, tap to toggle -->
                                <Button HorizontalAlignment="Stretch" Padding="4,5,4,3"
                                        Background="Transparent" BorderThickness="0"
                                        HorizontalContentAlignment="Left"
                                        Click="ToggleSection_Click"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="Expand or collapse this section">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind Chevron}" FontSize="12"
                                                   Foreground="{ThemeResource MetadataTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{ThemeResource MetadataTextBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <ItemsControl ItemsSource="{x:Bind VisibleRows}"
                                              Visibility="{x:Bind BodyVisibility, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="pages:UnifiedPlanRow">
                                            <StackPanel Spacing="0">
                                                <!-- Plan row: dense two-line layout. Line 1 = status glyph + name + kind chip + root badge
                                                                                                     (conditional) + inline state. Line 2 = one condensed subtitle (recommendation,
                                                                                                     covered requirements, or first unresolved
                                                                                                     requirement). Full tag chips and the full
                                                                                                     requirement-chip list live in the details
                                                                                                     pane, keeping the row compact so more mods
                                                                                                     are visible at once. -->
                                                                                                <Grid ColumnSpacing="10" Padding="4,2"
                                                                                                      Background="{x:Bind IsRowSelected, Mode=OneWay, Converter={StaticResource BoolToHighlightBrushConverter}}"
                                                                                                      Tapped="Row_Tapped"
                                                                                                      Tag="{x:Bind}"
                                                                                                      Visibility="{Binding IsPlanRow, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                                    <Grid.ColumnDefinitions>
                                                                                                        <ColumnDefinition Width="*" />
                                                                                                        <ColumnDefinition Width="Auto" />
                                                                                                    </Grid.ColumnDefinitions>
                                                                                                    <StackPanel Grid.Column="0" Spacing="0" VerticalAlignment="Center">
                                                                                                        <!-- Line 1: glyph + name + kind chip + root badge + inline state. -->
                                                                                                        <Grid ColumnSpacing="6">
                                                                                                            <Grid.ColumnDefinitions>
                                                                                                                <ColumnDefinition Width="*" />
                                                                                                                <ColumnDefinition Width="Auto" />
                                                                                                            </Grid.ColumnDefinitions>
                                                                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                                                                <FontIcon Glyph="{x:Bind PlanContainer.Entry.DerivedStateGlyph}"
                                                                                                                          FontSize="13" VerticalAlignment="Center" />
                                                                                                                <TextBlock Text="{x:Bind PlanContainer.Entry.Name}" FontWeight="SemiBold"
                                                                                                                           TextTrimming="CharacterEllipsis"
                                                                                                                           VerticalAlignment="Center" />
                                                                                                                <Border Style="{StaticResource FilterChipStyle}" Padding="6,0"
                                                                                                                        VerticalAlignment="Center">
                                                                                                                    <TextBlock Text="{x:Bind PlanContainer.Entry.KindText, FallbackValue='mod'}"
                                                                                                                               FontSize="10" VerticalAlignment="Center" />
                                                                                                                </Border>
                                                                                                                <!-- Root origin badge: shown only when the plan has more than one root. The name of
                                                                                                                     the root this dependency belongs to is carried in the tooltip. -->
                                                                                                                <Border Style="{StaticResource FilterChipStyle}" Padding="6,0"
                                                                                                                        VerticalAlignment="Center"
                                                                                                                        ToolTipService.ToolTip="{x:Bind PlanContainer.RootLabel, FallbackValue='Plan root'}"
                                                                                                                        Visibility="{Binding PlanContainer.HasRootLabel, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                                                                                                        <FontIcon Glyph="&#xE8B7;" FontSize="9" VerticalAlignment="Center" />
                                                                                                                                                                                        <TextBlock Text="root" FontSize="10" VerticalAlignment="Center" />
                                                                                                                    </StackPanel>
                                                                                                                </Border>
                                                                                                                <!-- Paths caution chip: shown while the row's install paths are
                                                                                                                     unreviewed heuristic defaults. The values stay in the
                                                                                                                     details pane, where the user reviews and accepts them. -->
                                                                                                                <Border Style="{StaticResource FilterChipStyle}" Padding="6,0"
                                                                                                                        VerticalAlignment="Center"
                                                                                                                        ToolTipService.ToolTip="The install source/destination are defaults that still need a look before installing"
                                                                                                                        Visibility="{Binding PlanContainer.PathsNeedReview, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                                                                                                        <FontIcon Glyph="&#xE8BA;" FontSize="9" VerticalAlignment="Center"
                                                                                                                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                                                                                                        <TextBlock Text="Paths" FontSize="10" VerticalAlignment="Center" />
                                                                                                                    </StackPanel>
                                                                                                                </Border>
                                                                                                            </StackPanel>
                                                                                                            <TextBlock Grid.Column="1" Text="{x:Bind PlanContainer.Entry.DerivedStateText}"
                                                                                                                       Opacity="0.7" FontSize="12"
                                                                                                                       TextTrimming="CharacterEllipsis"
                                                                                                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                                                                        </Grid>
                                                                                                        <!-- Line 2: one condensed subtitle, plus a thin download bar while downloading. -->
                                                                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                                                            <TextBlock Text="{x:Bind PlanContainer.SubtitleText}"
                                                                                                                       Opacity="0.65" FontSize="12"
                                                                                                                       TextTrimming="CharacterEllipsis"
                                                                                                                       VerticalAlignment="Center"
                                                                                                                       Visibility="{Binding PlanContainer.SubtitleText, Converter={StaticResource NullToVisibilityConverter}}" />
                                                                                                            <ProgressBar Minimum="0" Maximum="1" Width="80" Height="3"
                                                                                                                         VerticalAlignment="Center"
                                                                                                                         Value="{x:Bind PlanContainer.Entry.DownloadProgress}"
                                                                                                                         Visibility="{x:Bind PlanContainer.Entry.IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                                                        </StackPanel>
                                                                                                    </StackPanel>
                                                                                                    <Button Grid.Column="1" Style="{StaticResource RowActionButtonStyle}"
                                                                                                            Content="⋮" Click="RowActions_Click"
                                                                                                            Tag="{x:Bind}"
                                                                                                            ToolTipService.ToolTip="More actions for this mod" />
                                                                                                </Grid>
                                                <!-- In-profile row (installed mod not part of the current plan) -->
                                                <Grid ColumnSpacing="10" Padding="4,3"
                                                      Background="{x:Bind IsRowSelected, Mode=OneWay, Converter={StaticResource BoolToHighlightBrushConverter}}"
                                                      Tapped="Row_Tapped"
                                                      Tag="{x:Bind}"
                                                      Visibility="{Binding IsInProfileRow, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Grid.Column="0" Glyph="{x:Bind SessionRow.StatusGlyph}"
                                                              FontSize="14" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind SessionRow.Name}" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind SessionRow.StatusText}" Opacity="0.7"
                                                                   FontSize="12" TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding SessionRow.HasStatusText, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource RowActionButtonStyle}"
                                                            Content="Remove"
                                                            Click="Remove_Click"
                                                            Tag="{x:Bind}"
                                                            Visibility="{Binding SessionRow.IsRemovable, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            ToolTipService.ToolTip="Remove this installed mod from the profile" />
                                                </Grid>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty state: shown when there is no plan and no installed content to list. -->
                    <StackPanel x:Name="ListEmptyState" Spacing="8" Padding="8"
                                HorizontalAlignment="Center" VerticalAlignment="Top"
                                Visibility="{x:Bind ListEmptyStateVisibility, Mode=OneWay}">
                <FontIcon x:Name="ListEmptyGlyph" Glyph="&#xE71C;" FontSize="28"
                          HorizontalAlignment="Center" />
                <TextBlock x:Name="ListEmptyTitle" Text="Nothing to manage yet"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           HorizontalAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="ListEmptyBody" Text="Add a mod to start planning its dependencies, or install mods from the library."
                               Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Grid>

            <controlsToolkit:GridSplitter x:Name="DetailsSplitter" Grid.Column="1" Width="8"
                                          HorizontalAlignment="Stretch"
                                          ResizeDirection="Columns" ResizeBehavior="BasedOnAlignment"
                                          Visibility="Collapsed"
                                          AutomationProperties.Name="Resize details pane" />

            <!-- Details pane: a card that opens when a row is selected and reclaims the list's
                 space when closed (no selection). "Back to list" closes it in the narrow drill-in
                 mode where the list is hidden behind it. -->
            <Border x:Name="DetailsCard" Grid.Column="2" Margin="12,0,0,0" Padding="16"
                    HorizontalAlignment="Stretch" Visibility="Collapsed"
                    Style="{StaticResource ContentCardStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button x:Name="BackToListButton" Grid.Row="0" HorizontalAlignment="Left"
                            Click="BackToList_Click" Visibility="Collapsed"
                            Style="{StaticResource RowActionButtonStyle}"
                            AutomationProperties.Name="Back to list">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72B;" FontSize="14" />
                            <TextBlock Text="Back to list" />
                        </StackPanel>
                    </Button>
                    <!-- Tabbed details pane: Overview (the mod's identity, decisions, and tags —
                         the information a user is most likely to change), Install (FOMOD options,
                         archive preview, destination), and Details (read-only metadata). Each tab
                         scrolls independently; only the active tab is realized. -->
                    <Pivot x:Name="DetailsPivot" Grid.Row="1">
                        <PivotItem x:Name="OverviewTab" Header="Overview">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="OverviewHost" Spacing="4" />
                            </ScrollViewer>
                        </PivotItem>
                        <PivotItem x:Name="InstallTab" Header="Install">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="InstallHost" Spacing="4" />
                            </ScrollViewer>
                        </PivotItem>
                        <PivotItem x:Name="DetailsTab" Header="Details">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="DetailsHost" Spacing="4" />
                            </ScrollViewer>
                        </PivotItem>
                    </Pivot>
                </Grid>
            </Border>
        </Grid>

        <!-- Install action bar -->
        <Border Grid.Row="5" Style="{StaticResource ContentCardStyle}" Padding="12,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ActionStatusText" Grid.Column="0"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}" />
                <ProgressBar x:Name="InstallProgress" Grid.Column="1"
                             Minimum="0" Maximum="1" Value="0"
                             VerticalAlignment="Center"
                             Visibility="Collapsed"
                             IsEnabled="False" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ReviewChangesButton" Content="Review changes"
                            ToolTipService.ToolTip="Preview what will be installed, removed, or replaced before applying"
                            Click="ReviewChanges_Click"
                            IsEnabled="False"
                            Style="{StaticResource RowActionButtonStyle}" Padding="12,6" />
                    <Button x:Name="CancelButton" Content="Cancel"
                            Visibility="Collapsed"
                            Click="Cancel_Click"
                            IsEnabled="{x:Bind Session.CanCancel, Mode=OneWay}" />
                    <Button x:Name="InstallReadyButton" Content="Apply changes"
                            ToolTipService.ToolTip="Commit: install the selected mods and apply any queued removals to this profile"
                            Click="InstallReady_Click"
                            IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</pages:PageBase>
