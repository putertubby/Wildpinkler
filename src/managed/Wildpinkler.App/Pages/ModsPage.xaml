<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Wildpinkler.App.Pages.ModsPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Wildpinkler.App.Models"
    xmlns:services="using:Wildpinkler.App.Services"
    xmlns:controls="using:Wildpinkler.App.Controls"
    xmlns:pages="using:Wildpinkler.App.Pages"
    xmlns:controlsToolkit="using:CommunityToolkit.WinUI.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="FocusSearch_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Padding="{StaticResource PageContentPadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Mods" VerticalAlignment="Center" />
            <CommandBar Grid.Column="1" DefaultLabelPosition="Right" HorizontalAlignment="Right" Background="Transparent">
                <AppBarButton x:Name="AddModButton" Command="{x:Bind AddModCommand}" Icon="Add" Label="Add mod"
                              ToolTipService.ToolTip="Pick one or more archives to add">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="N" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton x:Name="DeleteSelectedButton" Command="{x:Bind DeleteSelectedCommand}" Icon="Delete" Label="Delete selected"
                              ToolTipService.ToolTip="Queue deletion of the selected mods">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Delete" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton x:Name="SelectUnusedButton" Command="{x:Bind SelectUnusedCommand}" Icon="Filter" Label="Select unused"
                                  ToolTipService.ToolTip="Select every mod that is not used by a profile" />
                    <AppBarButton x:Name="CheckUpdatesButton" Command="{x:Bind CheckUpdatesCommand}" Icon="Sync" Label="Check updates"
                                  ToolTipService.ToolTip="Checks every remotely managed mod, not just the selection" />
                    <AppBarButton x:Name="DownloadUpdatesButton" Command="{x:Bind DownloadUpdatesCommand}" Icon="Download" Label="Download updates"
                                  ToolTipService.ToolTip="Downloads updates for every remotely managed mod, not just the selection" />
                    <AppBarSeparator />
                    <AppBarButton x:Name="IdentifySelectedButton" Command="{x:Bind IdentifySelectedCommand}" Label="Identify from site"
                                  ToolTipService.ToolTip="Look the selected archive up by its checksum and fill in its details" />
                    <AppBarSeparator />
                    <AppBarButton x:Name="GoToDownloadsButton" Click="GoToDownloads_Click" Label="Show downloads"
                                  ToolTipService.ToolTip="Open the Downloads page" />
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <InfoBar x:Name="PageInfoBar" Grid.Row="1" IsOpen="False" />

        <Grid x:Name="ListDetailsGrid" Grid.Row="3" Loaded="ListDetailsGrid_Loaded" SizeChanged="ListDetailsGrid_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumnDef" Width="*" MinWidth="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="DetailsColumnDef" Width="360" MinWidth="280" MaxWidth="640" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource ContentCardStyle}" Margin="0,0,12,0">
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <controls:CollectionListHeader x:Name="ListHeader" Grid.Row="0"
                                                   PlaceholderText="Search mods by name, game, or version"
                                                   ResultCountText="{x:Bind ResultCountText, Mode=OneWay}"
                                                   SelectedCountText="{x:Bind SelectedCountText, Mode=OneWay}"
                                                   HasChips="{x:Bind HasActiveFilters, Mode=OneWay}"
                                                   Visibility="{x:Bind HasCollectionHeader, Mode=OneWay}"
                                                   QueryChanged="ListHeader_QueryChanged">
                        <controls:CollectionListHeader.FiltersContent>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <DropDownButton x:Name="FilterButton" Content="{x:Bind FilterButtonText, Mode=OneWay}"
                                                AutomationProperties.Name="Filter mods">
                                    <DropDownButton.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuFlyoutSubItem x:Name="GameFilterMenu" Text="Game" />
                                            <MenuFlyoutSubItem x:Name="StatusFilterMenu" Text="Status">
                                                <RadioMenuFlyoutItem GroupName="ModStatusFilter" Tag="All" Text="All statuses"
                                                                     IsChecked="True" Click="StatusFilter_Click" />
                                                <RadioMenuFlyoutItem GroupName="ModStatusFilter" Tag="Available" Text="Available"
                                                                     Click="StatusFilter_Click" />
                                                <RadioMenuFlyoutItem GroupName="ModStatusFilter" Tag="Unused" Text="Unused"
                                                                     Click="StatusFilter_Click" />
                                                <RadioMenuFlyoutItem GroupName="ModStatusFilter" Tag="UpdateAvailable" Text="Update available"
                                                                     Click="StatusFilter_Click" />
                                                <RadioMenuFlyoutItem GroupName="ModStatusFilter" Tag="DependencyIssue" Text="Dependency issue"
                                                                     Click="StatusFilter_Click" />
                                            </MenuFlyoutSubItem>
                                        </MenuFlyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>

                                <DropDownButton x:Name="SortButton" Content="{x:Bind SortButtonText, Mode=OneWay}"
                                                AutomationProperties.Name="Sort mods">
                                    <DropDownButton.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <RadioMenuFlyoutItem GroupName="ModSortField" Tag="Name" Text="Name"
                                                                 IsChecked="True" Click="SortField_Click" />
                                            <RadioMenuFlyoutItem GroupName="ModSortField" Tag="RecentlyAdded" Text="Recently added"
                                                                 Click="SortField_Click" />
                                            <RadioMenuFlyoutItem GroupName="ModSortField" Tag="Version" Text="Version"
                                                                 Click="SortField_Click" />
                                            <RadioMenuFlyoutItem GroupName="ModSortField" Tag="Status" Text="Status"
                                                                 Click="SortField_Click" />
                                        </MenuFlyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </StackPanel>
                        </controls:CollectionListHeader.FiltersContent>

                        <controls:CollectionListHeader.ChipsContent>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ItemsControl x:Name="FilterChipList" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:WrapPanel ItemSpacing="8" LineSpacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="pages:ModFilterChip">
                                            <Border Style="{StaticResource FilterChipStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock VerticalAlignment="Center" Text="{x:Bind Label}" />
                                                    <Button Style="{StaticResource ChipRemoveButtonStyle}"
                                                            Click="RemoveFilterChip_Click"
                                                            AutomationProperties.Name="{x:Bind RemoveDescription}"
                                                            ToolTipService.ToolTip="{x:Bind RemoveDescription}">
                                                        <FontIcon Glyph="&#xE711;" FontSize="10" />
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Clear all" Click="ClearFilters_Click" VerticalAlignment="Center" />
                            </StackPanel>
                        </controls:CollectionListHeader.ChipsContent>
                    </controls:CollectionListHeader>

                    <Grid Grid.Row="1" AllowDrop="True"
                          DragEnter="ModListDropTarget_DragEnter" DragOver="ModListDropTarget_DragOver"
                          DragLeave="ModListDropTarget_DragLeave" Drop="ModListDropTarget_Drop">
                        <ListView x:Name="ModList" SelectionMode="Extended" SelectionChanged="ModList_SelectionChanged"
                                  ItemContainerStyle="{StaticResource ListRowContainerStyle}"
                                  Padding="0,4,0,4">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ModEntry">
                                    <Grid Padding="{StaticResource ListRowPadding}" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" MinWidth="160" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Click="ModRowOpenPage_Click" Text="Open mod page" IsEnabled="{x:Bind HasRemotePage, Mode=OneWay}" />
                                                <MenuFlyoutItem Click="ModRowReveal_Click" Text="Reveal archive in Explorer" IsEnabled="{x:Bind HasArchive, Mode=OneWay}" />
                                                <MenuFlyoutItem Click="ModRowEditDependencies_Click" Text="Edit dependencies..." />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Click="ModRowDelete_Click" Text="Delete" />
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>
                                        <Border Style="{StaticResource RowAvatarStyle}">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Text="{x:Bind Name, Mode=OneWay, Converter={StaticResource InitialLetterConverter}}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           Text="{x:Bind Name, Mode=OneWay}" />
                                                <FontIcon Grid.Column="1" Glyph="&#xE7BA;" FontSize="14"
                                                          Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                          Visibility="{x:Bind HasDependencyIssue, Mode=OneWay}"
                                                          ToolTipService.ToolTip="{x:Bind DependencyIssueSummary, Mode=OneWay}"
                                                          AutomationProperties.Name="{x:Bind DependencyIssueSummary, Mode=OneWay}" />
                                            </Grid>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource ModRowTextStyle}" Opacity="0.62"
                                                           Text="{x:Bind Game, Mode=OneWay}" />
                                                <TextBlock Grid.Column="1" Opacity="0.56" Text="{x:Bind Status, Mode=OneWay}" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock x:Name="ModListStatus"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Opacity="0.68"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Visibility="Collapsed" />

                        <ProgressRing HorizontalAlignment="Center" VerticalAlignment="Center" Width="32" Height="32"
                                      IsActive="{x:Bind IsLoading, Mode=OneWay}"
                                      Visibility="{x:Bind IsLoading, Mode=OneWay}" />

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="320"
                                    Visibility="{x:Bind HasNoMods, Mode=OneWay}">
                            <FontIcon HorizontalAlignment="Center" Glyph="&#xE7B8;" FontSize="40" Opacity="0.5" />
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="No mods yet" />
                            <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Opacity="0.68"
                                       Text="Add a mod archive to start building your library." />
                            <Button HorizontalAlignment="Center" Margin="0,4,0,0" Style="{StaticResource AccentButtonStyle}"
                                    Content="Add a mod" Command="{x:Bind AddModCommand}" />
                        </StackPanel>

                        <Grid x:Name="DropOverlay" IsHitTestVisible="False" Visibility="{x:Bind IsDragOver, Mode=OneWay}">
                            <Border CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.15" />
                            <Border CornerRadius="8" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <FontIcon HorizontalAlignment="Center" Glyph="&#xE8B5;" FontSize="32"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Text="Drop archives here to add them to the mods list" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <controlsToolkit:GridSplitter x:Name="DetailsSplitter" Grid.Column="1" Width="8"
                                          HorizontalAlignment="Stretch"
                                          ResizeDirection="Columns" ResizeBehavior="BasedOnAlignment"
                                          Visibility="Collapsed"
                                          AutomationProperties.Name="Resize details pane" />

            <Border x:Name="DetailsCard" Grid.Column="2" Margin="12,0,0,0" Padding="16" Visibility="Collapsed"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource ContentCardStyle}">
                <StackPanel Spacing="12">
                    <Button x:Name="BackToListButton" Command="{x:Bind BackToListCommand}" Visibility="Collapsed"
                            AutomationProperties.Name="Back to list">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72B;" FontSize="14" />
                            <TextBlock Text="Back to list" />
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Style="{StaticResource RowAvatarStyle}" Width="44" Height="44">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="16"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind DetailsName.Text, Mode=OneWay, Converter={StaticResource InitialLetterConverter}}" />
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="DetailsName" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailsIdentity" Opacity="0.62" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" />
                    <Grid RowSpacing="8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="STATUS" />
                        <TextBlock x:Name="DetailsStatus" Grid.Column="1" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Style="{StaticResource SectionLabelStyle}" Text="SOURCE" />
                        <TextBlock x:Name="DetailsSource" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Style="{StaticResource SectionLabelStyle}" Text="ARCHIVE" />
                        <TextBlock x:Name="DetailsArchive" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="3" Style="{StaticResource SectionLabelStyle}" Text="FOMOD" />
                        <TextBlock x:Name="DetailsFomod" Grid.Row="3" Grid.Column="1" />
                        <TextBlock Grid.Row="4" Style="{StaticResource SectionLabelStyle}" Text="ADDED" />
                        <TextBlock x:Name="DetailsAdded" Grid.Row="4" Grid.Column="1" />
                        <TextBlock Grid.Row="5" Style="{StaticResource SectionLabelStyle}" Text="PROFILES" />
                        <TextBlock x:Name="DetailsProfiles" Grid.Row="5" Grid.Column="1" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="4" ColumnSpacing="16">
            <TextBlock x:Name="QueueStatus" HorizontalAlignment="Right" Opacity="0.72" />
        </Grid>
    </Grid>
</Page>
