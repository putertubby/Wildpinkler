<Project>

  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>

    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <ArtifactsDir>$(RepoRoot)build\</ArtifactsDir>
    <SharedOutDir>$(ArtifactsDir)bin\$(Platform)\$(Configuration)\</SharedOutDir>
    <SharedObjDir>$(ArtifactsDir)obj\$(MSBuildProjectName)\$(Platform)\$(Configuration)\</SharedObjDir>
  </PropertyGroup>

  <!-- Native and managed output must land in one directory so the app sits next to its native DLLs. -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <BaseOutputPath>$(SharedOutDir)</BaseOutputPath>
    <OutputPath>$(SharedOutDir)</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- XAML compiler and WindowsAppSDK generators emit these; they are not actionable in our sources. -->
    <NoWarn>$(NoWarn);CS1591;CA1416</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
